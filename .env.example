# Copy this file to .env for local development (never commit .env).
# On Vercel, set these under Project -> Settings -> Environment Variables instead.
# Church details (address, phone, EIN, Zelle) are already built into config/settings.py;
# set the CHURCH_* variables only to change them.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# On Vercel, DEBUG is off automatically.
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://bethelatlanta.org,https://www.bethelatlanta.org   # only for your own domain

# Leave empty locally to use SQLite. On Vercel: Supabase -> Connect -> Transaction pooler URI
# (port 6543), with [YOUR-PASSWORD] replaced by your database password. See DEPLOY.md step 1.
# DATABASE_URL=postgresql://postgres.abcdefgh:YourPassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Pastor Abraham's first password, applied by the build only while he has none. Delete after first login.
# INITIAL_ADMIN_PASSWORD=

# Stripe (https://dashboard.stripe.com/apikeys). Leave empty to show only Zelle / check / pledge.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Shown on the giving page and receipts
CHURCH_EIN=20-0604532
CHURCH_ZELLE=678-974-6608
CHURCH_EMAIL=bethelatlanta26@gmail.com
CHURCH_PHONE=404-723-4407
CHURCH_ADDRESS=5915 Lawrenceville Hwy, Tucker, GA 30084
CHURCH_MAILING_ADDRESS=5915 Lawrenceville Hwy, Tucker, GA 30084
CHURCH_CHECK_PAYABLE=Bethel Eritrean Alliance Church

# File uploads on the Resources page (Supabase Storage, private bucket). See DEPLOY.md "Later".
# SUPABASE_S3_BUCKET=resources
# SUPABASE_S3_ENDPOINT=https://abcdefgh.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=us-east-1
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=

# Email for receipts and password resets (e.g. Gmail app password, SendGrid, Resend SMTP)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Bethel Eritrean Church <giving@yourchurch.org>
